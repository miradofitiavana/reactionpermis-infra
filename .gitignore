.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# envs/*.tfvars = relevé de la topologie AWS (VPC, ARNs ALB, priorités listener),
# pas de secret dedans : mot de passe RDS et credentials Lyra sont injectés dans
# Secrets Manager hors Terraform. Sans cette exception, `*.tfvars` masquait tout
# envs/ et la description de l'infrastructure n'était sauvegardée nulle part.
!envs/*.tfvars
# Sauf les fichiers de valeurs sensibles (DSN Sentry) : jamais commités, un
# .example par environnement documente leur forme.
envs/*.secret.tfvars
!envs/*.secret.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Scripts locaux contenant des secrets (pas commit)
.env.*.ps1
.env.*.sh
