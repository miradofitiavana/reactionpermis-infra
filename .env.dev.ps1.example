# TEMPLATE: copier en `.env.dev.ps1` (gitignored) et remplir.
#
# Usage:
#   1. Copy-Item .env.dev.ps1.example .env.dev.ps1
#   2. Edit .env.dev.ps1 avec vraies valeurs
#   3. Début de session: `. .\.env.dev.ps1`
#      (le `.` initial = sourcing PowerShell ; sans lui les variables disparaissent)
#
# ⚠️ Il n'y a PLUS de TF_VAR_* pour les secrets. Tout ce que Terraform manipule
# atterrit en clair dans le tfstate — y compris une variable marquée `sensitive`,
# qui n'est masquée qu'à l'affichage. Les valeurs sont donc poussées directement
# dans Secrets Manager, hors Terraform. Ce fichier ne sert plus qu'à préparer la
# commande d'injection sans laisser les secrets dans l'historique du shell.
#
# Le secret AWS s'appelle `reactionpermis-<env>-app` et contient 4 clés. Les
# quatre doivent exister : ecs.tf les référence une par une et ECS refuse de
# démarrer la task si l'une manque (ResourceInitializationError).
#
#   $j = @{
#       APP_KEY       = 'base64:...'   # php artisan key:generate --show
#       DB_PASSWORD   = '...'
#       LYRA_USERNAME = '...'
#       LYRA_PWD      = '...'
#   } | ConvertTo-Json -Compress
#   aws secretsmanager put-secret-value --secret-id reactionpermis-dev-app --secret-string $j
#   aws ecs update-service --cluster reactionpermis-dev-cluster --service reactionpermis-dev-app --force-new-deployment
#
# put-secret-value remplace le JSON ENTIER : pousser une seule clé efface les
# autres et coupe l'accès MySQL. Toujours relire, modifier, repousser le tout.
#
# ⚠️ Le mot de passe Lyra doit être IDENTIQUE à WEB_API_REACTION_LYRA_PWD côté API
# organisme : c'est avec lui que l'IPN vérifie la signature du retour de paiement.
# Deux valeurs différentes = client débité, réservation jamais confirmée.
#
# ⚠️ En dev, utiliser les clés de TEST de la boutique. Le mode test ne se choisit
# pas par l'URL (endpoint identique) mais par le jeu de clés — et la base Aurora
# est partagée avec la prod, donc un paiement crée une vraie ligne dans
# organisme_reservations.

# ─── Optional: AWS profile / region ──────────────────────────────────────────
# $env:AWS_PROFILE = 'reactionpermis-dev'
# $env:AWS_REGION  = 'eu-west-3'

Write-Host "[OK] Env vars loaded for reactionpermis-aws dev" -ForegroundColor Green
